# Copy to .env and fill in. The CLI loads this file without overriding real env.
# Never commit the real .env. It is gitignored.
# The CLI reads the .env in this repository (editable install), or
# ~/.config/prompt-workflow/.env (%APPDATA%\prompt-workflow\.env on Windows). To use another
# file, set PROMPT_WORKFLOW_ENV=/path/to/.env in the real environment (not in a .env file).

PROMPT_PROVIDER=openrouter
PROMPT_PROFILE=default
# Your role, stated in the first person. Opens the CONTEXT section of the `default`
# profile's rewrite and the `-p-` snippet. Leave empty for no fixed persona.
PROMPT_PERSONA=
# PROMPT_PERSONA="I am working as a Head of Data at Example Corp."
PROMPT_TIMEOUT_SECONDS=30
# Timeout for the pro tier (-ip-), which runs a slower reasoning model.
PROMPT_PRO_TIMEOUT_SECONDS=60
# Profile for the pro tier (-ip-, -if-); empty uses PROMPT_PROFILE.
PROMPT_PRO_PROFILE=default-pro
PROMPT_TEMPERATURE=0.2

# Local providers are ungated only on localhost. Pointed at another machine, or with an
# Ollama cloud model (a :cloud or -cloud tag), the draft leaves this one, so the
# data-protection gate applies as it does to the cloud providers.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false

# LM Studio (OpenAI-compatible, local, no key needed)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# OpenRouter (cloud, default provider). Leave key empty if company policy
# does not permit sending drafts off-machine; the data-protection gate blocks
# sensitive content regardless, but use PROMPT_PROVIDER=ollama for full local-only use.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=2400
# Pin one serving endpoint. OpenRouter routes a model across many hosts that differ in
# latency, price and output quality; see the benchmark section in README.md. List the tags
# with GET https://openrouter.ai/api/v1/models/<author>/<slug>/endpoints. Leave empty for
# OpenRouter's own blended routing.
OPENROUTER_PROVIDER=google-ai-studio/flex
# true keeps the pin a preference, so a dead endpoint falls back instead of erroring.
# false pins hard: predictable cost and latency, but outages become visible failures.
OPENROUTER_ALLOW_FALLBACKS=true
# Reasoning effort (none/minimal/low/medium/high). Leave empty for models without a
# reasoning control. Gemini 3.x cannot turn thinking off; minimal keeps it fast.
OPENROUTER_REASONING_EFFORT=minimal
# Pro tier (-ip- / --tier pro): a reasoning model for hard, multi-part drafts.
OPENROUTER_PRO_MODEL=openai/gpt-6-luna
OPENROUTER_PRO_PROVIDER=openai
OPENROUTER_PRO_REASONING_EFFORT=low

# Anthropic / Claude (cloud). Leave key empty unless policy permits cloud use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=2400

# Set true only to allow cloud calls on content flagged as sensitive.
ALLOW_CLOUD_OVERRIDE=false
# Your own ;-separated, case-insensitive regexes the gate also blocks on, e.g. project code
# names or customer-ID formats. Write a literal ; as \x3b.
PROMPT_EXTRA_PATTERNS=
# PROMPT_EXTRA_PATTERNS="project[- ]falcon;CUST-\d{6}"
